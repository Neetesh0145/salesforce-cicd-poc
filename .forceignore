# Files the Salesforce CLI should never push/deploy or retrieve.
# Syntax: https://developer.salesforce.com/docs/atlas.en-us.sfdx_dev.meta/sfdx_dev/sfdx_dev_exclude_source.htm

package.xml

# LWC configuration and tests
**/jsconfig.json
**/.eslintrc.json
**/__tests__/**

# Metadata that is usually environment-specific - deploy by hand if ever needed
**/profiles/**
**/settings/**
**/*.dup
**/appMenus/**
**/appSwitcher/**
